{
  "name": "@xquik/paperclip-plugin-xquik",
  "version": "0.2.0",
  "description": "Paperclip plugin for Twitter search, tweet lookup, profiles, timelines & X trends. Not affiliated with X Corp.",
  "type": "module",
  "license": "MIT",
  "author": "Xquik",
  "homepage": "https://xquik.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xquik-dev/paperclip-plugin-xquik.git"
  },
  "bugs": {
    "url": "https://github.com/Xquik-dev/paperclip-plugin-xquik/issues"
  },
  "keywords": [
    "paperclip",
    "paperclip-plugin",
    "paperclip-twitter",
    "paperclip-ai-twitter",
    "paperclip-x-plugin",
    "xquik",
    "twitter-search",
    "twitter-api",
    "agent-api"
  ],
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.11"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ./esbuild.config.ts",
    "check:reproducible": "node ./scripts/check-reproducible.ts",
    "typecheck": "tsc --noEmit && type-coverage -p tsconfig.json --strict --at-least 100",
    "lint": "eslint --config eslint.config.ts --flag unstable_native_nodejs_ts_config --max-warnings 0 .",
    "test": "vitest run --coverage --config ./vitest.config.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "2026.1012.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.4",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "type-coverage": "2.30.4",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
