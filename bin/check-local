#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Xquik Contributors
# SPDX-License-Identifier: MIT
#
# Runs every check a change must pass before it lands or ships.
# Stops at the first failure and says what to do next.
# Reports the result as the xquik-local-checks commit status on GitHub
# when the tree is clean and the commit is pushed. Pass --no-status to skip it.

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

readonly status_repo="Xquik-dev/paperclip-plugin-xquik"
readonly status_context="xquik-local-checks"

post_status=true
for arg in "$@"; do
	case $arg in
		--no-status) post_status=false ;;
		*)
			printf 'Unknown option %s. Run bin/check-local or bin/check-local --no-status.\n' "$arg" >&2
			exit 2
			;;
	esac
done

status_sha=$(git rev-parse HEAD)
if [[ $post_status == true ]]; then
	if ! command -v gh >/dev/null 2>&1; then
		post_status=false
		printf 'Not posting the %s status. Install the GitHub CLI to post it.\n' "$status_context"
	elif [[ -n "$(git status --porcelain)" ]]; then
		post_status=false
		printf 'Not posting the %s status. Commit or remove local changes first.\n' "$status_context"
	elif ! gh api --silent "repos/$status_repo/commits/$status_sha" >/dev/null 2>&1; then
		post_status=false
		printf 'Not posting the %s status. Push commit %s first, or check gh auth status.\n' \
			"$status_context" "${status_sha:0:12}"
	fi
fi

# send_status <state> <description>
send_status() {
	local description=${2:0:139}
	if [[ $post_status == true ]] &&
		! gh api --silent "repos/$status_repo/statuses/$status_sha" \
			-f state="$1" -f context="$status_context" -f description="$description" >/dev/null; then
		printf 'Could not post the %s status. Check gh auth status.\n' "$status_context" >&2
	fi
}

current_check=""
license_checked=false

report_result() {
	local exit_status=$?
	if ((exit_status == 0)); then
		if [[ $license_checked == true ]]; then
			send_status success "REUSE, install, types, tests, build, reproducible package, audit & pack passed"
		else
			send_status success "Install, types, tests, build, reproducible package, audit & pack passed. REUSE was skipped."
		fi
	elif [[ -z $current_check ]]; then
		send_status failure "Stopped before the checks finished."
	elif ((exit_status == 130)); then
		send_status failure "Interrupted during $current_check."
	else
		send_status failure "Failed at $current_check. Earlier checks passed."
	fi
	exit "$exit_status"
}
trap report_result EXIT
trap 'exit 130' INT TERM

send_status pending "Running local checks."

# run_check <name> <next step> <command...>
run_check() {
	local name=$1
	local next_step=$2
	shift 2
	current_check=$name
	printf 'Running the %s check.\n' "$name"
	if ! "$@"; then
		printf 'The %s check failed. %s\n' "$name" "$next_step" >&2
		exit 1
	fi
	current_check=""
}

if command -v reuse >/dev/null 2>&1; then
	run_check "license metadata" \
		"Add SPDX headers or a REUSE.toml entry for the files it lists." \
		reuse lint
	license_checked=true
else
	printf 'Skipping the license metadata check. Install reuse to run it.\n'
fi

run_check "pnpm version" \
	"Install the pnpm version that package.json pins, then retry." \
	pnpm --version

run_check "install" \
	"Follow the pnpm message above, then retry." \
	pnpm install --frozen-lockfile

run_check "types, tests and build" \
	"Fix the error it reports, or cover the lines it lists." \
	pnpm check

run_check "reproducible package" \
	"Remove timestamps or other changing output from the build." \
	pnpm check:reproducible

run_check "dependency audit" \
	"Update the vulnerable dependency, then retry." \
	pnpm audit --audit-level=low

run_check "package contents" \
	"Fix the files list in package.json." \
	pnpm pack --dry-run

printf 'All checks passed.\n'
